// 개발은 SQLite, 배포 때 PostgreSQL로 바꾼다 (provider만 변경).
// SQLite는 enum을 지원하지 않아 level, kind는 문자열로 둔다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Law {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  versions    LawVersion[]
  bookmarks   Bookmark[]
  recentViews RecentView[]
  notes       Note[]
  caseLinks   CaseArticle[]
}

model LawVersion {
  id            String      @id @default(cuid())
  lawId         String
  law           Law         @relation(fields: [lawId], references: [id], onDelete: Cascade)
  effectiveDate String // YYYY-MM-DD
  sourceFile    String?
  importedAt    DateTime    @default(now())
  provisions    Provision[]

  @@unique([lawId, effectiveDate])
}

model Provision {
  id        String      @id
  versionId String
  version   LawVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Provision?  @relation("tree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Provision[] @relation("tree")
  /// 항·호·목이 속한 조. 조 하나를 한 번에 불러올 때 쓴다.
  articleId String?
  /// PART | CHAPTER | SECTION | SUBSECTION | ARTICLE | PARAGRAPH | ITEM | SUBITEM
  level     String
  number    Int
  branch    Int         @default(0)
  /// 조: "750의2", 항: "①", 호: "1.", 목: "가.", 편: "제1편"
  key       String
  /// 조 정렬용 (750의2 → 75002). 조가 아니면 0
  sortKey   Int         @default(0)
  /// 문서 안 순서
  seq       Int
  title     String?
  text      String      @default("")
  isDeleted Boolean     @default(false)
  /// 개정 표기, 줄바꿈으로 구분
  amendNote String?

  refsFrom ProvisionRef[] @relation("from")
  refsTo   ProvisionRef[] @relation("to")

  @@index([versionId, level, sortKey])
  @@index([versionId, level, key])
  @@index([articleId])
}

model ProvisionRef {
  fromId String
  from   Provision @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Provision @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  /// REF(참조) | APPLY(준용)
  kind   String

  @@id([fromId, toId])
  @@index([toId])
}

// ── 회원 ──────────────────────────────────────────
// 회원 데이터는 Provision id가 아니라 (lawId, articleKey)로 조문을 가리킨다.
// law:import가 버전을 지우고 다시 넣으면 Provision id가 바뀌기 때문.

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  sessions     Session[]
  bookmarks    Bookmark[]
  recentViews  RecentView[]
  notes        Note[]
}

model Session {
  /// 쿠키 토큰의 sha256 해시
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Bookmark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawId      String
  law        Law      @relation(fields: [lawId], references: [id], onDelete: Cascade)
  articleKey String
  createdAt  DateTime @default(now())

  @@id([userId, lawId, articleKey])
  @@index([userId, createdAt])
}

model RecentView {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawId      String
  law        Law      @relation(fields: [lawId], references: [id], onDelete: Cascade)
  articleKey String
  viewedAt   DateTime @default(now())

  @@id([userId, lawId, articleKey])
  @@index([userId, viewedAt])
}

model Note {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawId      String
  law        Law      @relation(fields: [lawId], references: [id], onDelete: Cascade)
  articleKey String
  body       String
  updatedAt  DateTime @updatedAt

  @@id([userId, lawId, articleKey])
  @@index([userId, updatedAt])
}

// ── 판례 ──────────────────────────────────────────
// 법령정보센터 판례 API에서 수집. 조문과는 (lawId, articleKey)로 연결한다.

model Case {
  /// 판례일련번호
  id           String        @id
  /// 사건번호 (예: 2013다40681)
  caseNo       String        @unique
  court        String
  /// YYYY-MM-DD
  decidedAt    String
  caseName     String
  /// 판시사항
  holdings     String        @default("")
  /// 판결요지
  summary      String        @default("")
  /// 참조조문 원문
  refArticles  String        @default("")
  /// 참조판례 원문
  refCases     String        @default("")
  /// 판례 전문
  fullText     String        @default("")
  /// 수집한 판례들 가운데 이 판례를 참조판례로 든 수
  citedBy      Int           @default(0)
  /// 직접 붙이는 "기출" 표시
  examMarked   Boolean       @default(false)
  /// AI가 판결요지에서 원문 그대로 발췌한 핵심 문장 (JSON 문자열 배열)
  keySentences String?
  keyModel     String?
  fetchedAt    DateTime      @default(now())
  articles     CaseArticle[]

  @@index([decidedAt])
}

model CaseArticle {
  caseId     String
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawId      String
  law        Law    @relation(fields: [lawId], references: [id], onDelete: Cascade)
  articleKey String

  @@id([caseId, lawId, articleKey])
  @@index([lawId, articleKey])
}
